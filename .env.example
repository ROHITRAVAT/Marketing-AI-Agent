APP_NAME=Marketing AI Agent
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Database (Docker service name used as host inside the Docker network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://marketing:CHANGE_ME@postgres:5432/marketing_ai

# Qdrant (Docker service name used as host inside the Docker network)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Vector dimension for Qdrant collections — MUST match the embedding model used
# to generate vectors (default 384 is only for infrastructure verification).
QDRANT_VECTOR_SIZE=384

# Ollama (Docker service name used as host inside the Docker network)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
# Model to use for inference. Kept EMPTY on purpose: Qwen 3 is installed in a
# separate task. Ollama connectivity must already work with no model installed.
OLLAMA_MODEL=