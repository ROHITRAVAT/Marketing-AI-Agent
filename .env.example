APP_NAME=Marketing AI Agent
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing
POSTGRES_PASSWORD=your_password
DATABASE_URL=postgresql+asyncpg://marketing:your_password@localhost:5432/marketing_ai

# JWT
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT=10

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_TIMEOUT=30

# password reset token lifetime
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ravatrohit670@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=ravatrohit670@gmail.com
SMTP_FROM_NAME=Marketing AI Agent
FRONTEND_URL=http://localhost:5173

# LangChain
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_MAX_TOKENS=1024
LANGCHAIN_TOP_P=0.9
LANGCHAIN_TOP_K=40
