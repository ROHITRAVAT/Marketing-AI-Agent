APP_NAME=Marketing AI Agent
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing
POSTGRES_PASSWORD=your_password
DATABASE_URL=postgresql+asyncpg://marketing:your_password@localhost:5432/marketing_ai

# JWT authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# OAuth Token Encryption Key (must be 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT=10

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_TIMEOUT=30

# password reset token lifetime
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ravatrohit670@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=ravatrohit670@gmail.com
SMTP_FROM_NAME=Marketing AI Agent
FRONTEND_URL=http://localhost:5173

# LangChain
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_MAX_TOKENS=1024
LANGCHAIN_TOP_P=0.9
LANGCHAIN_TOP_K=40

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback

# Facebook / Meta
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/facebook/callback

# Twitter / X
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/integrations/twitter/callback
