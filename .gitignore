# ─── Python ─────────────────────────────────────────────
# Virtual environment (isolated Python install — regenerable)
.venv/

# Python bytecode cache (auto-generated by Python)
__pycache__/
*.py[cod]

# ─── Secrets ────────────────────────────────────────────
# NEVER commit environment variables (API keys, passwords)
.env

# ─── Node.js / Frontend ─────────────────────────────────
# Installed JS packages (regenerable with `npm install`)
node_modules/

# Built frontend output (regenerable with `npm run build`)
dist/

# ─── Editors & OS ───────────────────────────────────────
# Personal VS Code settings (not project code)
.vscode/

# macOS desktop clutter (harmless to ignore on Windows too)
.DS_Store

# ─── Logs ───────────────────────────────────────────────
*.log